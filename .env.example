# Copy this file to .env and fill it in. Never share .env.
# Same bot token as m3bot_payment/.env (used to check Telegram logins).
BOT_TOKEN=paste_your_bot_token_here
BOT_USERNAME=KeygenytnYef_bot
ADMIN_ID=6423965105

# Where the bot's database lives (shared with the bot so balances match).
# Default: ../m3bot_payment/bot_data.db
BOT_DB_PATH=../m3bot_payment/bot_data.db
# Folder that contains receipt_image.py (default: ../m3bot_payment)
BOT_DIR=../m3bot_payment

RECEIPT_DESIGN=matched
INITDATA_MAX_AGE=86400
# Comma-separated site origins allowed to call the API. * is fine when the frontend is served by this API.
ALLOWED_ORIGINS=*
